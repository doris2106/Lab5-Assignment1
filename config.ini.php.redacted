; Matomo [database] section as deployed on matomo-lab4 (EC2) after the RDS cutover.
; Full file lives at /var/www/matomo/config/config.ini.php on the EC2 instance.
; Password redacted for this public repo; the live value is a dedicated, least-privilege
; application credential (not the RDS master/admin password).

[database]
host = "matomo-rds.chu4e4kcinv9.ap-south-1.rds.amazonaws.com"
username = "matomo_app"
password = "REDACTED"
dbname = "matomo"
tables_prefix = "matomo_"
charset = "utf8mb4"
collation = "utf8mb4_uca1400_ai_ci"
enable_ssl = 1
ssl_ca = "/etc/ssl/certs/aws-rds-global-bundle.pem"
